# =============================================================================
# LLM Provider
# =============================================================================

# "local" uses Ollama; "gemini" uses Google Gemini API
LLM_PROVIDER=local

# --- Google Gemini (only needed when LLM_PROVIDER=gemini) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
# Seconds to pause between Gemini requests (rate-limit guard)
GEMINI_REQUEST_PAUSE=0.0

# --- Ollama (only needed when LLM_PROVIDER=local) ---
OLLAMA_BASE_URL=http://localhost:11434

# --- Model selection ---
# Fast model used by the decomposer and Mem0 internals
LIGHTWEIGHT_LLM=llama3.2
# Higher-quality model for document processing (falls back to LIGHTWEIGHT_LLM if unset)
QUALITY_LLM=
# Model used by the Mem0 memory layer
MEM0_LLM=phi3.5
# Embedding model — must produce 768-dimensional vectors
EMBED_MODEL=nomic-embed-text

# =============================================================================
# Qdrant Vector Store
# =============================================================================

QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=knowledge_base
# Must match the output dimension of EMBED_MODEL
QDRANT_VECTOR_SIZE=768

# =============================================================================
# Storage Paths
# =============================================================================

FILE_STORE_PATH=./knowledge-store
GRAPH_STORE_PATH=./data/graph

# =============================================================================
# Retrieval Thresholds
# =============================================================================

# Minimum score to trigger a Tier 1 result
START_THRESHOLD=0.85
# Tier 1 confident-hit cutoff
CONFIDENT_THRESHOLD=0.85

# =============================================================================
# Graph Propagation
# =============================================================================

# Minimum Mem0 score required to use a result as a graph anchor
GRAPH_ANCHOR_THRESHOLD=0.50
# Score decay applied per BFS hop
PROPAGATION_DECAY=0.90
# Minimum score allowed per hop during propagation
PROPAGATION_HOP_THRESHOLD=0.55
# Maximum BFS depth
PROPAGATION_MAX_DEPTH=4
# Maximum nodes returned from propagation
PROPAGATION_MAX_NODES=25
# Score penalty applied to stub (incomplete) entities
STUB_PENALTY=0.50

# =============================================================================
# Entity Linking
# =============================================================================

LINK_THRESHOLD=0.88
LINK_AMBIGUOUS_MIN=0.82

# =============================================================================
# Segmentation
# =============================================================================

# "paragraph" or "semantic"
SEGMENT_MODE=paragraph
SEMANTIC_SPLIT_THRESHOLD=0.75
MIN_SEGMENT_CHARS=150

# =============================================================================
# Features
# =============================================================================

WEB_SEARCH_ENABLED=true
# "async" or "sync"
HITL_MODE=async
